<script>
    document.addEventListener(
        'DOMContentLoaded',
        function () {

            /*
             * ==========================================
             * TABLE SEARCH
             * ==========================================
             *
             * This searches the currently loaded page.
             * Laravel pagination still controls the
             * actual database pagination.
             */

            const searchInput =
                document.getElementById(
                    'crudTableSearch'
                );

            const tableBody =
                document.getElementById(
                    'crudTableBody'
                );


            if (
                searchInput &&
                tableBody
            ) {

                searchInput.addEventListener(
                    'input',
                    function () {

                        const search =
                            this.value
                                .trim()
                                .toLowerCase();


                        const rows =
                            tableBody.querySelectorAll(
                                'tr'
                            );


                        rows.forEach(
                            function (row) {

                                /*
                                 * Ignore empty state row.
                                 */

                                if (
                                    row.querySelector(
                                        '.crud-empty'
                                    )
                                ) {

                                    return;

                                }


                                const text =
                                    row.textContent
                                        .toLowerCase();


                                row.style.display =
                                    !search ||
                                    text.includes(
                                        search
                                    )
                                        ? ''
                                        : 'none';

                            }
                        );

                    }
                );

            }


            /*
             * ==========================================
             * DELETE CONFIRMATION
             * ==========================================
             */

            document
                .querySelectorAll(
                    '.crud-delete-form'
                )
                .forEach(
                    function (form) {

                        form.addEventListener(
                            'submit',
                            function (event) {

                                const confirmed =
                                    window.confirm(
                                        'Are you sure you want to delete this record?'
                                    );


                                if (!confirmed) {

                                    event.preventDefault();

                                }

                            }
                        );

                    }
                );

        }
    );
</script>

@endsection